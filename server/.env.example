# Twenty CRM MCP server config
# Copy to .env and fill in.

# Twenty's REST API base. Note the /rest suffix.
API_BASE_URL=http://your-twenty-host:3000/rest

# Long-lived workspace API key from Twenty UI:
#   Settings → Developers → API Keys
# Variable name is fixed by the OpenAPI security scheme name (bearerAuth).
BEARER_TOKEN_BEARERAUTH=
